{
  "name": "app-scaffold",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "concurrently \"pnpm run panda -- --watch\" \"next dev --turbopack\"",
    "build:jobs": "node scripts/compileJobs.mjs",
    "build": "pnpm run build:jobs && pnpm run panda && next build",
    "start": "next start",
    "lint": "pnpm run lint:env && pnpm run lint:md && biome check . && pnpm exec eslint .",
    "lint:md": "markdownlint '**/*.md' --ignore node_modules",
    "format": "biome format . --write",
    "pretest": "pnpm run panda",
    "test": "vitest run",
    "pretest:coverage": "pnpm run panda",
    "test:coverage": "vitest run --coverage",
    "pree2e": "pnpm run panda",
    "e2e": "vitest run -c vitest.e2e.config.ts",
    "pree2e:smoke": "pnpm run panda",
    "e2e:smoke": "vitest run -c vitest.e2e.config.ts --testNamePattern \"@smoke\"",
    "reanalyze": "ts-node --transpile-only scripts/updateMissingAnalysis.ts",
    "poll:snailmail": "ts-node --transpile-only scripts/pollSnailMail.ts",
    "scan:inbox": "ts-node --transpile-only scripts/scanInbox.ts",
    "cleanup:anon-cases": "ts-node --transpile-only scripts/cleanupAnonymousCases.ts",
    "migrate": "ts-node --transpile-only scripts/migrate.ts",
    "lint:env": "dotenv-linter .env.example",
    "lint:env:local": "dotenv-linter .env",
    "seed:cases": "ts-node --transpile-only scripts/seedCases.ts",
    "https": "local-ssl-proxy --source 443 --target 3000",
    "storybook": "concurrently \"pnpm run panda -- --watch\" \"storybook dev -p 6006\"",
    "prebuild-storybook": "pnpm run panda",
    "build-storybook": "storybook build",
    "storybook:screenshot": "pnpm run build-storybook && storycap http://localhost:6006 --serverCmd \"http-server storybook-static -p 6006\" --out storybook-screenshots",
    "generate:schemas": "ts-to-zod --skipValidation --all && pnpm run validate:generated",
    "validate:generated": "tsc --noEmit -p tsconfig.generated.json",
    "generate:migrations": "drizzle-kit generate:sqlite",
    "squash:migrations": "ts-node --transpile-only scripts/squashMigrations.ts",
    "website": "ts-node --transpile-only scripts/generateWebsiteImages.ts && eleventy",
    "panda": "panda",
    "pretypecheck": "pnpm run panda",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anatine/zod-openapi": "^2.2.8",
    "@auth/core": "^0.34.3",
    "@auth/drizzle-adapter": "^1.11.2",
    "@floating-ui/dom": "^1.7.6",
    "@floating-ui/react": "^0.27.19",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@react-aria/combobox": "^3.16.0",
    "@react-aria/listbox": "^3.16.0",
    "@react-aria/textfield": "^3.19.0",
    "@react-stately/combobox": "^3.14.0",
    "@tanstack/react-query": "^5.100.10",
    "@tanstack/react-query-devtools": "^5.100.10",
    "@tanstack/react-virtual": "^3.13.24",
    "@tensorflow/tfjs": "^4.22.0",
    "@tensorflow/tfjs-backend-wasm": "^4.22.0",
    "better-sqlite3": "^12.10.0",
    "casbin": "^5.50.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "exif-parser": "^0.1.12",
    "form-data": "^4.0.5",
    "i18next": "^26.2.0",
    "imapflow": "^1.3.3",
    "is-mobile": "^5.0.0",
    "jsdom": "^26.1.0",
    "mailparser": "^3.9.8",
    "next": "15.5.18",
    "next-auth": "^4.24.14",
    "nodemailer": "^8.0.7",
    "onnxruntime-web": "^1.26.0",
    "openai": "^6.38.0",
    "pdf-lib": "^1.17.1",
    "pigeon-maps": "^0.22.1",
    "react": "^19.2.6",
    "react-aria": "^3.48.0",
    "react-dom": "^19.2.6",
    "react-hot-toast": "^2.6.0",
    "react-i18next": "^17.0.8",
    "react-icons": "^5.6.0",
    "react-mermaid2": "^0.1.4",
    "react-zoom-pan-pinch": "^4.0.3",
    "sharp": "^0.34.5",
    "twilio": "^6.0.2",
    "unleash-client": "^6.11.0",
    "unleash-proxy-client": "^3.8.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.5",
    "@axe-core/cli": "^4.11.3",
    "@biomejs/biome": "^1.9.4",
    "@eslint/eslintrc": "^3.3.5",
    "@faker-js/faker": "^10.4.0",
    "@openapitools/openapi-generator-cli": "^2.32.0",
    "@pandacss/dev": "^0.54.0",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/addon-interactions": "^8.6.14",
    "@storybook/nextjs": "^8.6.14",
    "@storybook/react": "^8.6.14",
    "@storybook/testing-library": "^0.2.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@ts-rest/core": "^3.52.1",
    "@ts-rest/open-api": "^3.52.1",
    "@types/node": "^25.8.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/react-i18next": "^8.1.0",
    "@types/testing-library__dom": "^7.5.0",
    "@vitejs/plugin-react": "^4.5.1",
    "@vitest/coverage-v8": "^3.2.3",
    "commander": "^14.0.3",
    "concurrently": "^9.2.1",
    "dotenv-linter": "^0.2.0",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.0",
    "eslint": "^9",
    "eslint-config-next": "15.5.18",
    "eslint-plugin-eslint-comments": "^3.2.0",
    "http-server": "^14.1.1",
    "local-ssl-proxy": "^2.0.5",
    "markdownlint-cli": "^0.48.0",
    "storybook": "^8.6.14",
    "storycap": "^3.1.0",
    "ts-node": "^10.9.2",
    "ts-to-zod": "^3.15.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5",
    "vite-tsconfig-paths": "^4.2.0",
    "vitest": "^3.2.3"
  },
  "optionalDependencies": {
    "@biomejs/cli-linux-x64": "^1.9.4",
    "@rollup/rollup-linux-x64-gnu": "^4.60.4"
  }
}
